# Copy to .env and fill in values — no host/port defaults are hardcoded in config files.

SERVER_IP=localhost
BACKEND_PORT=5008
FRONTEND_PORT=3005
QUERY_TRACKER_PORT=5009

# Optional: run one portal per process (npm run start:hrms, start:assets, …).
# Each overrides BACKEND_PORT for that process so network.config stays valid.
# ADMIN_SERVICE_PORT=5010
# HRMS_SERVICE_PORT=5011
# ASSET_SERVICE_PORT=5012
# FINANCE_SERVICE_PORT=5013
# EMPLOYEE_SERVICE_PORT=5014
# QUERY_TRACKER_SERVICE_PORT=5015

# MongoDB (option A): single URI
# MONGO_URI=mongodb://user:pass@host:27017
# MongoDB (option B): host + port
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=worklytics_hrms

# DB_POOL_SIZE=12
# JWT_SECRET=your-secret
# MONGODB_URI= (alias of MONGO_URI in some setups)
