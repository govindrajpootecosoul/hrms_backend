# main_db layer (login) → 27012 | Ecosoul → 27013 | Thrive → 27014
MONGO_HOST=localhost
MONGO_PORT=27012

# DB + collection on login mongod (Compass ke mutabiq)
MONGO_LOGIN_DB_NAME=main_db
MONGO_USERS_COLLECTION=employee_details

SERVER_IP=localhost
BACKEND_PORT=5008
FRONTEND_PORT=3005
QUERY_TRACKER_PORT=5009

